---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.sitemaps.org/schemas/sitemap/0.9 http://www.sitemaps.org/schemas/sitemap/0.9/sitemap.xsd" xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:image="http://www.google.com/schemas/sitemap-image/1.1">
  <!-- Homepage -->
  <url>
    <loc>{{ site.url }}/</loc>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
    <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
    <image:image>
      <image:loc>{{ site.url }}/{{ site.data.profile.portrait_url }}</image:loc>
      <image:title>{{ site.data.profile.primary_name }} - Professional portrait</image:title>
      <image:caption>Professional portrait photo of {{ site.data.profile.primary_name }}</image:caption>
    </image:image>
  </url>
  
  <!-- Publications Page -->
  <url>
    <loc>{{ site.url }}/publications.html</loc>
    <changefreq>monthly</changefreq>
    <priority>0.9</priority>
    <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
  </url>
  
  <!-- Projects & Experience Page -->
  <url>
    <loc>{{ site.url }}/projects_experience.html</loc>
    <changefreq>monthly</changefreq>
    <priority>0.9</priority>
    <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
  </url>
  
  <!-- Showcase Page -->
  <url>
    <loc>{{ site.url }}/showcase.html</loc>
    <changefreq>monthly</changefreq>
    <priority>0.7</priority>
    <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
  </url>
  
  <!-- More Page -->
  <url>
    <loc>{{ site.url }}/more.html</loc>
    <changefreq>monthly</changefreq>
    <priority>0.6</priority>
    <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
  </url>
  
  <!-- Individual Publications -->
  {% for post in site.publications %}
  <url>
    <loc>{{ site.url }}{{ post.url }}</loc>
    <changefreq>yearly</changefreq>
    <priority>0.8</priority>
    <lastmod>{{ post.date | date_to_xmlschema }}</lastmod>
    {% if post.cover %}
    <image:image>
      <image:loc>{{ site.url }}/{{ post.cover }}</image:loc>
      <image:title>{{ post.title }}</image:title>
      <image:caption>Cover image for publication: {{ post.title }}</image:caption>
    </image:image>
    {% endif %}
  </url>
  {% endfor %}
  
  <!-- News Items -->
  {% for post in site.news %}
  <url>
    <loc>{{ site.url }}{{ post.url }}</loc>
    <changefreq>monthly</changefreq>
    <priority>0.6</priority>
    <lastmod>{{ post.date | date_to_xmlschema }}</lastmod>
  </url>
  {% endfor %}
  
  <!-- Showcase Items -->
  {% for post in site.showcase %}
  <url>
    <loc>{{ site.url }}{{ post.url }}</loc>
    <changefreq>monthly</changefreq>
    <priority>0.5</priority>
    <lastmod>{{ post.date | date_to_xmlschema }}</lastmod>
  </url>
  {% endfor %}
</urlset>